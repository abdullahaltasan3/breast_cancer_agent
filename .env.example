# Copy this file to ".env" (same folder) and put your key in it. Never share or commit .env.
OPENAI_API_KEY=sk-...your-key...
LLM_MODEL=gpt-5.4-mini

# Optional: any OpenAI-compatible provider instead of OpenAI (the model must support tool calling)
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1                      LLM_MODEL=llama-3.3-70b-versatile
# Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_API_KEY=ollama   LLM_MODEL=qwen2.5:7b
